{
	"name": "@rimbu/actor",
	"version": "0.15.9",
	"description": "State management tools to create stateful logic that can be easily integrated in any framework",
	"keywords": [
		"redux",
		"state management",
		"immutable",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/actor"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/actor.d.ts",
			"default": "./dist/entry/actor.js"
		},
		"./immer": {
			"types": "./dist/entry/immer.d.ts",
			"default": "./dist/entry/immer.js"
		},
		"./patch": {
			"types": "./dist/entry/patch.d.ts",
			"default": "./dist/entry/patch.js"
		},
		"./*": {
			"types": "./dist/public/actor/*.d.ts",
			"default": "./dist/public/actor/*.js"
		}
	},
	"imports": {
		"#actor/*": {
			"types": "./dist/public/actor/internal/*.d.ts",
			"default": "./dist/public/actor/internal/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/common": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@rimbu/deep": "workspace:*",
		"@rimbu/spy": "^0.7.7",
		"@rimbu/stream": "workspace:*",
		"happy-dom": "catalog:",
		"immer": "catalog:"
	},
	"optionalDependencies": {
		"@rimbu/deep": "workspace:*",
		"immer": "catalog:"
	}
}
