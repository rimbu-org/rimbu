{
	"compilerOptions": {
		"paths": {
			"@rimbu/graph": ["./src/graph.ts"],
			"@rimbu/graph/arrow-graph": ["./src/arrow-graph.ts"],
			"@rimbu/graph/arrow-valued-graph": ["./src/arrow-valued-graph.ts"],
			"@rimbu/graph/edge-graph": ["./src/edge-graph.ts"],
			"@rimbu/graph/edge-valued-graph": ["./src/edge-valued-graph.ts"],
			"@rimbu/graph/*": ["./src/*.ts"],
			"#graph/*": ["./src/internal/*.ts"],
			"#private/*": ["./src/internal/*.ts"],
			"entry/*": ["./src/*.ts"]
		}
	}
}
