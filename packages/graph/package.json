{
	"name": "@rimbu/graph",
	"version": "2.0.11",
	"description": "Immutable Graph data structures for TypeScript",
	"keywords": [
		"graph",
		"edge",
		"directed",
		"undirected",
		"vertex",
		"vertices",
		"weighted",
		"nodes",
		"traverse",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/graph"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/graph.d.ts",
			"default": "./dist/graph.js"
		},
		"./arrow-graph": {
			"types": "./dist/arrow-graph.d.ts",
			"default": "./dist/arrow-graph.js"
		},
		"./arrow-valued-graph": {
			"types": "./dist/arrow-valued-graph.d.ts",
			"default": "./dist/arrow-valued-graph.js"
		},
		"./edge-graph": {
			"types": "./dist/edge-graph.d.ts",
			"default": "./dist/edge-graph.js"
		},
		"./edge-valued-graph": {
			"types": "./dist/edge-valued-graph.d.ts",
			"default": "./dist/edge-valued-graph.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"imports": {
		"#graph/*": {
			"types": "./dist/internal/*.d.ts",
			"default": "./dist/internal/*.js"
		},
		"#private/*": {
			"types": "./dist/internal/*.d.ts",
			"default": "./dist/internal/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check src",
		"biome:fix": "biome check src --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format src",
		"lint:check": "biome lint src",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/collection-types": "workspace:*",
		"@rimbu/common": "workspace:*",
		"@rimbu/hashed": "workspace:*",
		"@rimbu/sorted": "workspace:*",
		"@rimbu/stream": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
