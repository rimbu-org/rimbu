{
	"name": "@rimbu/multiset",
	"version": "2.1.10",
	"description": "An immutable Set where each element can occur multiple times",
	"keywords": [
		"multiset",
		"bag",
		"mset",
		"hashed",
		"sorted",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/multiset"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/multiset.d.ts",
			"default": "./dist/entry/multiset.js"
		},
		"./hashed": {
			"types": "./dist/entry/hashed.d.ts",
			"default": "./dist/entry/hashed.js"
		},
		"./sorted": {
			"types": "./dist/entry/sorted.d.ts",
			"default": "./dist/entry/sorted.js"
		},
		"./*": {
			"types": "./dist/public/*.d.ts",
			"default": "./dist/public/*.js"
		}
	},
	"imports": {
		"#multiset/*": {
			"types": "./dist/public/internal/*.d.ts",
			"default": "./dist/public/internal/*.js"
		},
		"#hashed/*": {
			"types": "./dist/public/internal/hashed/*.d.ts",
			"default": "./dist/public/internal/hashed/*.js"
		},
		"#sorted/*": {
			"types": "./dist/public/internal/sorted/*.d.ts",
			"default": "./dist/public/internal/sorted/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"test:random": "bun test test-random",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/async-opt-lazy.d.ts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/collection-types": "workspace:*",
		"@rimbu/common": "workspace:*",
		"@rimbu/hashed": "workspace:*",
		"@rimbu/sorted": "workspace:*",
		"@rimbu/stream": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
