{
  "name": "@rimbu/multiset",
  "version": "2.1.10",
  "description": "An immutable Set where each element can occur multiple times",
  "keywords": [
    "multiset",
    "bag",
    "mset",
    "hashed",
    "sorted",
    "immutable",
    "collection",
    "rimbu",
    "typescript"
  ],
  "homepage": "https://rimbu.org",
  "author": {
    "name": "Arvid Nicolaas",
    "email": "arvid@rimbu.org",
    "url": "https://github.com/vitoke"
  },
  "license": "MIT",
  "funding": [
    {
      "type": "individual",
      "url": "https://github.com/sponsors/vitoke"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimbu-org/rimbu.git",
    "directory": "packages/multiset"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry/multiset.d.mts",
      "default": "./dist/entry/multiset.mjs"
    },
    "./hashed": {
      "types": "./dist/entry/hashed.d.mts",
      "default": "./dist/entry/hashed.mjs"
    },
    "./sorted": {
      "types": "./dist/entry/sorted.d.mts",
      "default": "./dist/entry/sorted.mjs"
    },
    "./*": {
      "types": "./dist/public/*.d.mts",
      "default": "./dist/public/*.mjs"
    }
  },
  "imports": {
    "#multiset/*": {
      "types": "./dist/public/internal/*.d.mts",
      "default": "./dist/public/internal/*.mjs"
    },
    "#hashed/*": {
      "types": "./dist/public/internal/hashed/*.d.mts",
      "default": "./dist/public/internal/hashed/*.mjs"
    },
    "#sorted/*": {
      "types": "./dist/public/internal/sorted/*.d.mts",
      "default": "./dist/public/internal/sorted/*.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "biome:check": "biome check --write",
    "biome:fix": "biome check --write",
    "build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
    "clean": "rimraf dist node_modules",
    "clean:build": "rimraf dist",
    "format:check": "biome format",
    "lint:check": "biome lint",
    "test": "bun test --tsconfig-override tsconfig.common.json",
    "test:random": "bun test test-random",
    "test:types": "bunx tsd --files ./test-d --typings ./dist/async-opt-lazy.d.mts",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "@rimbu/base": "workspace:*",
    "@rimbu/collection-types": "workspace:*",
    "@rimbu/common": "workspace:*",
    "@rimbu/hashed": "workspace:*",
    "@rimbu/sorted": "workspace:*",
    "@rimbu/stream": "workspace:*",
    "tslib": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
