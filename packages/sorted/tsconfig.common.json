{
	"compilerOptions": {
		"paths": {
			"@rimbu/sorted": ["./entry/sorted.ts"],
			"@rimbu/sorted/map": ["./entry/map.ts"],
			"@rimbu/sorted/set": ["./entry/set.ts"],
			"@rimbu/sorted/*": ["./public/*.ts"],
			"#sorted/*": ["./public/internal/sorted/*.ts"],
			"#map/*": ["./public/internal/map/*.ts"],
			"#set/*": ["./public/internal/set/*.ts"],
			"#private/*": ["./private/*.ts"]
		}
	}
}
