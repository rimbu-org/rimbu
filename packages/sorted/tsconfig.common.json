{
	"compilerOptions": {
		"paths": {
			"@rimbu/sorted": ["./src/sorted.ts"],
			"@rimbu/sorted/map": ["./src/public/map.ts"],
			"@rimbu/sorted/set": ["./src/public/set.ts"],
			"@rimbu/sorted/*": ["./src/public/*.ts", "./src/public/*"],
			"@rimbu/collection-types/*": [
				"../collection-types/*.ts",
				"../collection-types/*"
			],
			"#sorted/*": ["./src/internal/sorted/*.ts"],
			"#map/*": ["./src/internal/map/*.ts"],
			"#set/*": ["./src/internal/set/*.ts"]
		}
	}
}
