{
	"compilerOptions": {
		"paths": {
			"@rimbu/sorted": ["./sorted.ts"],
			"@rimbu/sorted/map": ["./map.ts"],
			"@rimbu/sorted/set": ["./set.ts"],
			"@rimbu/sorted/internal/*": ["./internal/*.ts", "./internal/*"],
			"#sorted/*": ["./internal/sorted/*.ts"],
			"#map/*": ["./internal/map/*.ts"],
			"#set/*": ["./internal/set/*.ts"]
		}
	}
}
