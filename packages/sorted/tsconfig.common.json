{
	"compilerOptions": {
		"paths": {
			"@rimbu/sorted": ["./src/sorted.ts"],
			"@rimbu/sorted/map": ["./src/map.ts"],
			"@rimbu/sorted/set": ["./src/set.ts"],
			"@rimbu/sorted/internal/*": ["./src/internal/*.ts", "./src/internal/*"],
			"@rimbu/collection-types/*": [
				"../collection-types/*.ts",
				"../collection-types/*"
			],
			"#sorted/*": ["./src/internal/sorted/*.ts"],
			"#map/*": ["./src/internal/map/*.ts"],
			"#set/*": ["./src/internal/set/*.ts"]
		}
	}
}
