{
	"name": "@rimbu/stream",
	"version": "3.0.3",
	"description": "Efficient structure representing a sequence of elements, with powerful operations for TypeScript",
	"keywords": [
		"stream",
		"lazy",
		"iterable",
		"sequence",
		"elements",
		"operations",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/stream"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/entry/stream.d.mts",
			"default": "./dist/entry/stream.mjs"
		},
		"./async": {
			"types": "./dist/entry/async-stream.d.mts",
			"default": "./dist/entry/async-stream.mjs"
		},
		"./*": {
			"types": "./dist/public/*.d.mts",
			"default": "./dist/public/*.mjs"
		}
	},
	"imports": {
		"#async/*": {
			"types": "./dist/public/async/internal/*.d.mts",
			"default": "./dist/public/async/internal/*.mjs"
		},
		"#stream/*": {
			"types": "./dist/public/internal/*.d.mts",
			"default": "./dist/public/internal/*.mjs"
		},
		"#private/*": {
			"types": "./dist/private/*.d.mts",
			"default": "./dist/private/*.mjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check --write",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"test": "bun test --tsconfig-override tsconfig.common.json",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/async-opt-lazy.d.mts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/common": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
