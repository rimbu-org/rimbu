{
	"name": "@rimbu/stream",
	"version": "3.0.3",
	"description": "Efficient structure representing a sequence of elements, with powerful operations for TypeScript",
	"keywords": [
		"stream",
		"lazy",
		"iterable",
		"sequence",
		"elements",
		"operations",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/stream"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/stream.d.ts",
			"default": "./dist/stream.js"
		},
		"./async": {
			"types": "./dist/public/async.d.ts",
			"default": "./dist/public/async.js"
		},
		"./advanced/*": {
			"types": "./dist/advanced/*.d.ts",
			"default": "./dist/advanced/*.js"
		},
		"./*": {
			"types": "./dist/public/*.d.ts",
			"default": "./dist/public/*.js"
		}
	},
	"imports": {
		"#async/*": {
			"types": "./dist/internal/async/*.d.ts",
			"default": "./dist/internal/async/*.js"
		},
		"#stream/*": {
			"types": "./dist/internal/*.d.ts",
			"default": "./dist/internal/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check src",
		"biome:fix": "biome check src --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"docs": "rimraf docs && bunx typedoc --options typedoc.json",
		"format:check": "biome format src",
		"lint:check": "biome lint src",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/common": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@rimbu/hashed": "workspace:*",
		"@rimbu/multimap": "workspace:*"
	}
}
