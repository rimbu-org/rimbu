{
	"compilerOptions": {
		"paths": {
			"@rimbu/stream": ["./stream.ts"],
			"@rimbu/stream/async": ["./async-stream.ts"],
			"@rimbu/stream/async/internal/fast-iterator-base": ["./internal/async/fast-iterator-base.ts"],
			"@rimbu/stream/async/internal/stream-base": ["./internal/async/stream-base.ts"],
