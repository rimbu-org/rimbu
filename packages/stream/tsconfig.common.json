{
	"compilerOptions": {
		"paths": {
			"@rimbu/stream": ["./entry/stream.ts"],
			"@rimbu/stream/async": ["./entry/async-stream.ts"],
			"@rimbu/stream/*": ["./public/*.ts"],
			"#async/*": ["./public/async/internal/*.ts"],
