{
	"name": "@rimbu/table",
	"version": "2.1.9",
	"description": "Immutable spreadsheet-like data structures containing row keys, column keys, and cell values",
	"keywords": [
		"table",
		"row",
		"column",
		"cell",
		"map",
		"spreadsheet",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/table"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/esm/main/index.d.ts",
			"import": "./dist/esm/main/index.js"
		},
		"./custom": {
			"types": "./dist/esm/custom/index.d.ts",
			"import": "./dist/esm/custom/index.js"
		},
		"./hash-row": {
			"types": "./dist/esm/hash-row/index.d.ts",
			"import": "./dist/esm/hash-row/index.js"
		},
		"./sorted-row": {
			"types": "./dist/esm/sorted-row/index.d.ts",
			"import": "./dist/esm/sorted-row/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/collection-types": "workspace:*",
		"@rimbu/common": "workspace:*",
		"@rimbu/hashed": "workspace:*",
		"@rimbu/sorted": "workspace:*",
		"@rimbu/stream": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
