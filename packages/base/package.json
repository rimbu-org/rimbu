{
	"name": "@rimbu/base",
	"version": "2.0.7",
	"description": "Utilities to implement Rimbu collections",
	"keywords": [
		"array",
		"rimbu",
		"internal",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/base"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check src",
		"biome:fix": "biome check src --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format src",
		"lint:check": "biome lint src",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/common": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
