{
	"compilerOptions": {
		"paths": {
			"@rimbu/hashed": ["./entry/hashed.ts"],
			"@rimbu/hashed/map": ["./entry/map.ts"],
			"@rimbu/hashed/set": ["./entry/set.ts"],
