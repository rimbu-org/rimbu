{
	"name": "@rimbu/hashed",
	"version": "2.1.10",
	"description": "Immutable HashMap and HashSet implementations for TypeScript",
	"keywords": [
		"hashmap",
		"hashset",
		"hashed",
		"map",
		"set",
		"immutable",
		"collection",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/hashed"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/hashed.d.ts",
			"default": "./dist/entry/hashed.js"
		},
		"./map": {
			"types": "./dist/entry/map.d.ts",
			"default": "./dist/entry/map.js"
		},
		"./set": {
			"types": "./dist/entry/set.d.ts",
			"default": "./dist/entry/set.js"
		},
		"./*": {
			"types": "./dist/public/*.d.ts",
			"default": "./dist/public/*.js"
		}
	},
	"imports": {
		"#hashed/*": {
			"types": "./dist/public/internal/hashed/*.d.ts",
			"default": "./dist/public/internal/hashed/*.js"
		},
		"#map/*": {
			"types": "./dist/public/internal/map/*.d.ts",
			"default": "./dist/public/internal/map/*.js"
		},
		"#set/*": {
			"types": "./dist/public/internal/set/*.d.ts",
			"default": "./dist/public/internal/set/*.js"
		},
		"#private/*": {
			"types": "./dist/private/*.d.ts",
			"default": "./dist/private/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check src",
		"biome:fix": "biome check src --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format src",
		"lint:check": "biome lint src",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"test:random": "bun test test-random",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@rimbu/base": "workspace:*",
		"@rimbu/collection-types": "workspace:*",
		"@rimbu/common": "workspace:*",
		"@rimbu/list": "workspace:*",
		"@rimbu/stream": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
