{
	"compilerOptions": {
		"paths": {
			"@rimbu/ordered/map": ["./src/map.ts"],
			"@rimbu/ordered/set": ["./src/set.ts"],
			"@rimbu/ordered/*": ["./src/*.ts"],
			"@rimbu/collection-types/*": [
