{
	"compilerOptions": {
		"paths": {
			"@rimbu/ordered": ["./entry/ordered.ts"],
			"@rimbu/ordered/map": ["./entry/map.ts"],
			"@rimbu/ordered/set": ["./entry/set.ts"],
			"@rimbu/ordered/*": ["./public/*.ts"],
