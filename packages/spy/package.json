{
	"name": "@rimbu/spy",
	"version": "0.7.7",
	"description": "Test utilities for spying, stubbing and mocking functions, objects and classes in TypeScript",
	"keywords": [
		"spy",
		"stub",
		"mock",
		"fake",
		"test",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/spy"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/entry/spy.d.ts",
			"import": "./dist/entry/spy.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"test": "bun test --tsconfig-override tsconfig.common.json",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/async-opt-lazy.d.ts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
