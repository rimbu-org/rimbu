{
	"name": "@rimbu/channel",
	"version": "3.0.3",
	"description": "Channel implementation for TypeScript akin to Go Channels",
	"keywords": [
		"channel",
		"rpc",
		"remote",
		"thread",
		"immutable",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/channel"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/channel.d.ts",
			"import": "./dist/entry/channel.js"
		},
		"./*": {
			"types": "./dist/public/*.d.ts",
			"default": "./dist/public/*.js"
		}
	},
	"imports": {
		"#channel/*": {
			"types": "./dist/public/internal/*.d.ts",
			"default": "./dist/public/internal/*.js"
		},
		"#private/*": {
			"types": "./dist/private/*.d.ts",
			"default": "./dist/private/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format": "yarn format:base --write",
		"format:base": "prettier \"{!CHANGELOG.md}|**/**/*.{ts,tsx,js,mts,mjs,json,md}\"",
		"format:check": "yarn format:base --check",
		"lint": "eslint src",
		"test": "bun test --tsconfig-override tsconfig.common.json",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/arr.d.ts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/common": "workspace:*",
		"@rimbu/stream": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
