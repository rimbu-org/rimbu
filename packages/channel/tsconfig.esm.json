{
	"extends": ["../../config/tsconfig.esm.base.json", "./tsconfig.common.json"],
	"include": ["src"],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"paths": {
			"@rimbu/channel": ["./channel.ts"],
			"@rimbu/channel/*": ["./public/*.ts"],
