{
	"compilerOptions": {
		"paths": {
			"@rimbu/bimultimap": [
				"./src/bimultimap.ts"
			],
			"@rimbu/bimultimap/advanced/*": [
				"./src/advanced/*.ts"
			],
			"@rimbu/bimultimap/*": [
				"./src/public/*.ts",
				"./src/public/*"
			],
			"#bimultimap/*": [
				"./src/internal/*.ts"
			],
			"#bimultimap/immutable/*": [
				"./src/internal/immutable/*.ts"
			]
		}
	}
}
