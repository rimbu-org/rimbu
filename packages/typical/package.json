{
	"name": "@rimbu/typical",
	"version": "0.8.7",
	"description": "Type-level numeric and string operations",
	"keywords": [
		"typelevel",
		"template literal",
		"literal types",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/typical"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/typical.d.ts",
			"import": "./dist/entry/typical.js"
		}
	},
	"imports": {
		"#typical/*": {
			"types": "./dist/public/internal/*.d.ts",
			"default": "./dist/public/internal/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/entry/typical.d.ts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
