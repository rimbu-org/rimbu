{
  "name": "@rimbu/task",
  "version": "2.0.6",
  "description": "Composable, cancellable, and supervised async task orchestration for TypeScript & JavaScript.",
  "keywords": [
    "task",
    "process",
    "coroutine",
    "cancellable",
    "asynchronous",
    "orchestration",
    "supervised",
    "rimbu",
    "typescript"
  ],
  "homepage": "https://rimbu.org",
  "author": {
    "name": "Arvid Nicolaas",
    "email": "arvid@rimbu.org",
    "url": "https://github.com/vitoke"
  },
  "license": "MIT",
  "funding": [
    {
      "type": "individual",
      "url": "https://github.com/sponsors/vitoke"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimbu-org/rimbu.git",
    "directory": "packages/task"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry/task.d.mts",
      "default": "./dist/entry/task.mjs"
    },
    "./*": {
      "types": "./dist/public/*.d.mts",
      "default": "./dist/public/*.mjs"
    }
  },
  "imports": {
    "#task/*": {
      "types": "./dist/public/internal/*.d.mts",
      "default": "./dist/public/internal/*.mjs"
    },
    "#private/*": {
      "types": "./dist/private/*.d.mts",
      "default": "./dist/private/*.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun clean && bunx tsc --p tsconfig.esm.json && bunx tsc-alias -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "circular": "npx -y madge --ts-config tsconfig.json --circular --extensions mts src/main/index.mts",
    "extract-api": "yarn extract-api:main && yarn extract-api:ops",
    "extract-api:main": "tsx ../../config/api-extractor.ts config/api-extractor.main.json",
    "extract-api:ops": "tsx ../../config/api-extractor.ts config/api-extractor.ops.json",
    "format": "yarn format:base --write",
    "format:base": "prettier \"{!CHANGELOG.md}|**/**/*.{ts,tsx,js,mts,mjs,json,md}\"",
    "format:check": "yarn format:base --check",
    "lint": "eslint src",
    "test": "bun test --tsconfig-override tsconfig.common.json",
    "test:types": "bunx tsd --files ./test-d --typings ./dist/arr.d.mts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@rimbu/channel": "workspace:*",
    "@rimbu/common": "workspace:*",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  }
}
