{
	"name": "@rimbu/task",
	"version": "2.0.6",
	"description": "Composable, cancellable, and supervised async task orchestration for TypeScript & JavaScript.",
	"keywords": [
		"task",
		"process",
		"coroutine",
		"cancellable",
		"asynchronous",
		"orchestration",
		"supervised",
		"rimbu",
		"typescript"
	],
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git",
		"directory": "packages/task"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/entry/task.d.ts",
			"default": "./dist/entry/task.js"
		},
		"./*": {
			"types": "./dist/public/*.d.ts",
			"default": "./dist/public/*.js"
		}
	},
	"imports": {
		"#task/*": {
			"types": "./dist/public/internal/*.d.ts",
			"default": "./dist/public/internal/*.js"
		},
		"#private/*": {
			"types": "./dist/private/*.d.ts",
			"default": "./dist/private/*.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "bun clean:build && bunx tsc --p tsconfig.esm.json",
		"clean": "rimraf dist node_modules",
		"clean:build": "rimraf dist",
		"format:check": "biome format",
		"lint:check": "biome lint",
		"test": "bun test test/* --tsconfig-override tsconfig.common.json",
		"test:types": "bunx tsd --files ./test-d --typings ./dist/async-opt-lazy.d.ts",
		"typecheck": "tsc -p tsconfig.esm.json --noEmit"
	},
	"dependencies": {
		"@rimbu/channel": "workspace:*",
		"@rimbu/common": "workspace:*",
		"tslib": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
