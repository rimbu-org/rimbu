{
	"name": "root",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@changesets/cli": "^2.29.8",
		"@happy-dom/global-registrator": "^20.4.0",
		"@types/bun": "^1.3.8",
		"bun-types": "^1.3.8",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"rimraf": "^6.1.2",
		"typedoc": "^0.28.16",
		"typedoc-theme-oxide": "^0.2.5",
		"ts6": "npm:typescript@6",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": "please-use-bun",
		"npm": "please-use-bun",
		"pnpm": "please-use-bun",
		"yarn": "please-use-bun"
	},
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"homepage": "https://rimbu.org",
	"license": "MIT",
	"private": true,
	"publishConfig": {
		"provenance": true
	},
	"scripts": {
		"biome:check": "bun --workspaces --if-present run biome:check",
		"biome:fix": "bun --workspaces --if-present run biome:fix",
		"build": "bun --workspaces --if-present run build",
		"build:seq": "bun --sequential --workspaces --if-present run build",
		"clean": "bun --workspaces --if-present run clean && rimraf node_modules",
		"clean:build": "bun --workspaces --if-present run clean:build",
		"commit": "git-cz",
		"docs": "typedoc --options config/typedoc.json",
		"format:check": "bun --workspaces --if-present run format:check",
		"lint:check": "bun --workspaces --if-present run lint:check",
		"prerelease": "bun typecheck && bun test:types && bun test && bun test:random",
		"release": "bun prerelease && bunx changeset publish",
		"test": "bun --workspaces --if-present run test",
		"test:types": "bun --workspaces --if-present run test:types",
		"test:random": "bun --workspaces --if-present run test:random",
		"typecheck": "bun --workspaces --if-present run typecheck",
		"version": "bunx changeset version"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"support/*"
		],
		"catalog": {
			"happy-dom": "^20.5.0",
			"immer": "^11.1.11"
		}
	}
}
