{
	"name": "root",
	"private": true,
	"homepage": "https://rimbu.org",
	"author": {
		"name": "Arvid Nicolaas",
		"email": "arvid@rimbu.org",
		"url": "https://github.com/vitoke"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/vitoke"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimbu-org/rimbu.git"
	},
	"scripts": {
		"biome:check": "bun --workspaces --if-present run biome:check",
		"biome:fix": "bun --workspaces --if-present run biome:fix",
		"build": "bun --workspaces --if-present run build",
		"clean": "bun --workspaces --if-present run clean && rimraf node_modules",
		"clean:build": "bun --workspaces --if-present run clean:build",
		"commit": "git-cz",
		"docs": "deno run --import-map doc-gen/import_map.json --allow-read --allow-write --no-check doc-gen/src/main.ts -i doc-gen/input -o docs/api",
		"format:check": "bun --workspaces --if-present run format:check",
		"lint:check": "bun --workspaces --if-present run lint:check",
		"postinstall": "husky",
		"prerelease": "yarn typecheck && yarn test:types && yarn test && yarn test:random",
		"publish:ci": "lerna publish from-package --yes",
		"test": "bun --workspaces --if-present run test",
		"test:types": "bun --workspaces --if-present run test:types",
		"test:random": "bun --workspaces --if-present run test:random",
		"typecheck": "bun --workspaces run typecheck",
		"version:ci": "lerna version --yes --conventional-commits --message 'chore(release): publish'",
		"version:localtest": "lerna version --yes --conventional-commits --no-git-tag-version --no-push",
		"version:prerelease": "lerna version --yes --conventional-commits --conventional-prerelease --message 'chore(release): prepublish canary'",
		"version:graduate": "lerna version --yes --conventional-commits --conventional-graduate --message 'chore(release): graduate prerelease packages'"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@happy-dom/global-registrator": "^20.4.0",
		"@microsoft/api-extractor": "^7.55.1",
		"@types/bun": "^1.3.8",
		"bun-types": "^1.3.8",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"lerna": "^9.0.3",
		"rimraf": "^6.1.2",
		"tsd": "^0.33.0",
		"typescript": "^5.9.3"
	},
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"tslib": "^2.8.1"
		}
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"publishConfig": {
		"provenance": true
	},
	"engines": {
		"node": "please-use-bun",
		"npm": "please-use-bun",
		"pnpm": "please-use-bun",
		"yarn": "please-use-bun"
	}
}
